<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/crest.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>Crest</AssemblyName>
    <RootNamespace>Crest</RootNamespace>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="System.Management" Version="10.0.0" /></ItemGroup>
  <ItemGroup><Resource Include="../../assets/crest.png" Link="crest.png"/><Content Include="../../assets/crest.ico" Link="crest.ico" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
  <ItemGroup><Resource Include="../../assets/focus-orb.png" Link="focus-orb.png"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../assets/timer-complete.wav" LogicalName="Crest.TimerComplete.wav" /></ItemGroup>
</Project>
